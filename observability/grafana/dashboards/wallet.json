{"title":"Wallet Service","schemaVersion":39,"version":1,"refresh":"10s","panels":[{"id":1,"type":"timeseries","title":"HTTP requests / second","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[1m])) by (uri)","legendFormat":"{{uri}}"}]},{"id":2,"type":"timeseries","title":"HTTP p95 latency","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))","legendFormat":"{{uri}}"}]},{"id":3,"type":"timeseries","title":"JVM heap used","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"})"}]},{"id":4,"type":"timeseries","title":"Database connections","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"jdbc_connections_active"}]}]}
